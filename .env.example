# Upstream OpenAI-compatible server URL (include /v1 path)
UPSTREAM_URL=http://localhost:8080/v1

# Network interface to bind the Ollama-facing server
LISTEN_HOST=0.0.0.0

# TCP port to listen on (Ollama default)
LISTEN_PORT=11434

# Maximum time in seconds to wait for an upstream response
REQUEST_TIMEOUT=300
